#!/bin/sh
# Steve (Mac / Linux): reviews input/Main and saves the results in reports/Main. Run ./setup once first.
cd "$(dirname "$0")" || exit 1
if [ ! -x .venv/bin/python ]; then
    echo "The tool is not set up on this computer yet. Run ./setup first."
    exit 1
fi
exec .venv/bin/python "$(pwd)/steve.py" review
