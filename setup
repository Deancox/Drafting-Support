#!/bin/sh
# Set Up (Mac / Linux): installs Python 3.12 if needed, then everything the Drawing QA tool needs into .venv.
cd "$(dirname "$0")" || exit 1

PY=""
for p in python3.13 python3.12 python3.11 python3 python; do
    if command -v "$p" >/dev/null 2>&1 && "$p" -c "import sys; sys.exit(sys.version_info < (3, 11))" 2>/dev/null; then
        PY="$p"; break
    fi
done
if [ -z "$PY" ]; then
    echo "Python 3.11 or newer is not installed."
    if command -v brew >/dev/null 2>&1; then
        echo "Installing it with Homebrew ..."; brew install python@3.12 && PY="$(brew --prefix)/bin/python3.12"
    elif command -v apt-get >/dev/null 2>&1; then
        echo "Installing it with apt (asks for your password) ..."
        sudo apt-get update && sudo apt-get install -y python3 python3-venv python3-pip && PY=python3
    fi
fi
if [ -z "$PY" ] || ! "$PY" -c "import sys; sys.exit(sys.version_info < (3, 11))" 2>/dev/null; then
    echo "Install Python 3.12 from https://www.python.org/downloads/ and run ./setup again."
    exit 1
fi
exec "$PY" "$(pwd)/steve.py" setup "$@"
